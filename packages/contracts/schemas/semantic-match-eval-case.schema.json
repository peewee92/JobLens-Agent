{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/semantic-match-eval-case.schema.json",
  "title": "SemanticMatchEvalCase",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "eligibility",
    "requirement",
    "candidates",
    "expectedEligibility",
    "expectedVerdict",
    "expectedEvidenceIds"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "eligibility": {"enum": ["eligible", "conditional", "blocked"]},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "importance",
        "originalText",
        "normalizedCapability",
        "eligibilityStatus",
        "eligibilityEvidenceIds",
        "profileFactRefs"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["skill", "experience", "education", "responsibility", "domain", "constraint"]},
        "importance": {"enum": ["must_have", "preferred", "bonus"]},
        "originalText": {"type": "string", "minLength": 1},
        "normalizedCapability": {"type": ["string", "null"]},
        "eligibilityStatus": {"enum": ["matched", "conditional", "missing"]},
        "eligibilityEvidenceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "profileFactRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidenceId",
          "evidenceKey",
          "evidenceType",
          "summary",
          "source",
          "relevanceTier",
          "retrievalBasis",
          "matchedTerms"
        ],
        "properties": {
          "evidenceId": {"type": "string", "minLength": 1},
          "evidenceKey": {"type": "string", "minLength": 1},
          "evidenceType": {"enum": ["work", "project", "education", "achievement", "self_report"]},
          "summary": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "relevanceTier": {"enum": ["direct", "related"]},
          "retrievalBasis": {"enum": ["exact_skill_link", "explicit_text_overlap", "related_capability_hint"]},
          "matchedTerms": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "expectedEligibility": {"enum": ["eligible", "conditional", "blocked"]},
    "expectedVerdict": {"enum": ["matched", "partial", "not_matched"]},
    "expectedEvidenceIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
