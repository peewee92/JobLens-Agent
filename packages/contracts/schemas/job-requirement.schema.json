{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/job-requirement.schema.json",
  "title": "JobRequirement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "jobId",
    "extractionId",
    "requirementIndex",
    "type",
    "originalText",
    "normalizedCapability",
    "importance",
    "evidenceSpan",
    "confidence",
    "extractorVersion"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "jobId": {"type": "string", "minLength": 1},
    "extractionId": {"type": "string", "minLength": 1},
    "requirementIndex": {"type": "integer", "minimum": 0},
    "type": {
      "enum": ["skill", "experience", "education", "responsibility", "domain", "constraint"]
    },
    "originalText": {"type": "string", "minLength": 1},
    "normalizedCapability": {"type": ["string", "null"]},
    "importance": {"enum": ["must_have", "preferred", "bonus"]},
    "evidenceSpan": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "extractorVersion": {"type": "string", "minLength": 1}
  }
}
