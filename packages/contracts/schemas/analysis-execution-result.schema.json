{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/analysis-execution-result.schema.json",
  "$defs": {
    "AnalysisExecutionWorkspaceResponse": {
      "properties": {
        "jobId": {
          "title": "Jobid",
          "type": "string"
        },
        "workspaceId": {
          "title": "Workspaceid",
          "type": "string"
        },
        "resumeVariantId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
