{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/search-intent.schema.json",
  "title": "SearchIntent",
  "type": "object",
  "required": [
    "id",
    "version",
    "targetRoles",
    "cities",
    "remoteAccepted",
    "minimumSalaryK",
    "seniority",
    "employmentTypes",
    "excludeKeywords",
    "hardConstraints",
    "softPreferences",
    "createdAt"
  ],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "targetRoles": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cities": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "remoteAccepted": {"type": ["boolean", "null"]},
    "minimumSalaryK": {"type": ["number", "null"], "minimum": 0},
    "seniority": {
      "enum": ["intern", "junior", "mid", "senior", "staff", "lead", "principal", null]
    },
    "employmentTypes": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "excludeKeywords": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "hardConstraints": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "softPreferences": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
