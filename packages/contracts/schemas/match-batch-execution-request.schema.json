{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/contracts/match-batch-execution-request.schema.json",
  "title": "Batch Match Execution Request",
  "description": "Explicit single round: up to 50 selected jobs and at most 5 newly processed ready jobs; continue using resumeJobIds.",
  "type": "object",
  "properties": {
    "jobIds": {"type": "array", "minItems": 1, "maxItems": 50, "items": {"type": "string"}},
    "maxReadyJobs": {"type": "integer", "minimum": 1, "maximum": 5, "default": 5}
  },
  "required": ["jobIds"]
}
