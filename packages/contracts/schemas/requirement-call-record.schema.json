{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "actionId": {
      "title": "Actionid",
      "type": "string"
    },
    "jobId": {
      "title": "Jobid",
      "type": "string"
    },
    "status": {
      "enum": [
        "running",
        "completed",
        "failed",
        "uncertain"
      ],
      "title": "Status",
      "type": "string"
    },
    "attempts": {
      "title": "Attempts",
      "type": "integer"
    },
    "responseStatus": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Responsestatus"
    },
    "inputTokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Inputtokens"
    },
    "outputTokens": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Outputtokens"
    },
    "extractionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Extractionid"
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Errorcode"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "maxOutputTokens": {
      "title": "Maxoutputtokens",
      "type": "integer"
    },
    "timeoutSeconds": {
      "title": "Timeoutseconds",
      "type": "number"
    }
  },
  "required": [
    "actionId",
    "jobId",
    "status",
    "attempts",
    "responseStatus",
    "inputTokens",
    "outputTokens",
    "extractionId",
    "errorCode",
    "model",
    "maxOutputTokens",
    "timeoutSeconds"
  ],
  "title": "RequirementCallRecord",
  "type": "object"
}
