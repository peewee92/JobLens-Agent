{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/analysis-comparison.schema.json",
  "$defs": {
    "AnalysisJobComparisonResponse": {
      "properties": {
        "jobId": {
          "title": "Jobid",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "previousReportId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previousreportid"
        },
        "currentReportId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentreportid"
        },
        "previousExtractionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previousextractionid"
        },
        "currentExtractionId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentextractionid"
        },
        "previousPolicyVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previouspolicyversion"
        },
        "currentPolicyVersion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentpolicyversion"
        },
        "previousRecommendation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previousrecommendation"
        },
        "currentRecommendation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentrecommendation"
        },
        "previousRank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previousrank"
        },
        "currentRank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentrank"
        },
        "rankChange": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Rankchange"
        },
        "signal": {
          "enum": [
            "improved",
            "weakened",
            "unchanged",
            "mixed",
            "not_comparable",
            "unavailable"
          ],
          "title": "Signal",
          "type": "string"
        },
        "recommendationChange": {
          "enum": [
            "improved",
            "weakened",
            "unchanged",
            "mixed",
            "not_comparable",
            "unavailable"
          ],
          "title": "Recommendationchange",
          "type": "string"
        },
        "coverageChange": {
          "enum": [
            "improved",
            "weakened",
            "unchanged",
            "mixed",
            "not_comparable",
            "unavailable"
          ],
          "title": "Coveragechange",
          "type": "string"
        },
        "reasonCodes": {
          "items": {
            "type": "string"
          },
          "title": "Reasoncodes",
          "type": "array"
        },
        "requirements": {
          "items": {
            "$ref": "#/$defs/RequirementChangeResponse"
          },
          "title": "Requirements",
          "type": "array"
        },
        "preferences": {
          "items": {
            "$ref": "#/$defs/PreferenceChangeResponse"
          },
          "title": "Preferences",
          "type": "array"
        }
      },
      "required": [
        "jobId",
        "title",
        "previousReportId",
        "currentReportId",
        "previousExtractionId",
        "currentExtractionId",
        "previousPolicyVersion",
        "currentPolicyVersion",
        "previousRecommendation",
        "currentRecommendation",
        "previousRank",
        "currentRank",
        "rankChange",
        "signal",
        "recommendationChange",
        "coverageChange",
        "reasonCodes",
        "requirements",
        "preferences"
      ],
      "title": "AnalysisJobComparisonResponse",
      "type": "object"
    },
    "PreferenceChangeResponse": {
      "properties": {
        "key": {
          "title": "Key",
          "type": "string"
        },
        "previousStatus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
