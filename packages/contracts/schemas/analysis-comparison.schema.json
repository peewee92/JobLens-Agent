        "previousCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previouscode"
        },
        "currentCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentcode"
        },
        "previousReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Previousreason"
        },
        "currentReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currentreason"
        }
      },
      "required": [
        "key",
        "previousStatus",
        "currentStatus",
        "previousCode",
        "currentCode",
        "previousReason",
        "currentReason"
      ],
      "title": "PreferenceChangeResponse",
      "type": "object"
    },
    "RequirementChangeResponse": {
      "properties": {
        "requirementId": {
          "title": "Requirementid",
          "type": "string"
        },
        "originalText": {
          "title": "Originaltext",
          "type": "string"
        },
        "previousCoverage": {
          "enum": [
            "supported",
            "partial",
            "unverified",
            "hard_conflict"
          ],
          "title": "Previouscoverage",
          "type": "string"
        },
        "currentCoverage": {
          "enum": [
            "supported",
            "partial",
            "unverified",
            "hard_conflict"
          ],
          "title": "Currentcoverage",
          "type": "string"
        },
        "previousReason": {
          "title": "Previousreason",
          "type": "string"
        },
        "currentReason": {
          "title": "Currentreason",
          "type": "string"
        },
        "previousEvidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Previousevidenceids",
          "type": "array"
        },
        "currentEvidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Currentevidenceids",
          "type": "array"
        },
        "previousFactRefs": {
          "items": {
            "type": "string"
          },
          "title": "Previousfactrefs",
          "type": "array"
        },
        "currentFactRefs": {
          "items": {
            "type": "string"
          },
          "title": "Currentfactrefs",
          "type": "array"
        },
        "change": {
          "enum": [
            "improved",
            "weakened",
            "unchanged",
            "mixed",
            "not_comparable",
            "unavailable"
          ],
          "title": "Change",
          "type": "string"
        }
      },
      "required": [
        "requirementId",
        "originalText",
        "previousCoverage",
        "currentCoverage",
        "previousReason",
        "currentReason",
        "previousEvidenceIds",
        "currentEvidenceIds",
        "previousFactRefs",
        "currentFactRefs",
        "change"
      ],
      "title": "RequirementChangeResponse",
      "type": "object"
    }
  },
  "properties": {
    "comparisonVersion": {
      "const": 1,
      "title": "Comparisonversion",
      "type": "integer"
    },
    "sourceThreadId": {
      "title": "Sourcethreadid",
      "type": "string"
    },
    "sourceResultId": {
      "title": "Sourceresultid",
      "type": "string"
    },
    "threadId": {
      "title": "Threadid",
      "type": "string"
    },
    "resultId": {
      "title": "Resultid",
      "type": "string"
    },
    "scope": {
      "enum": [
        "targets",
        "batch"
      ],
      "title": "Scope",
      "type": "string"
    },
    "previousProfileVersion": {
      "title": "Previousprofileversion",
      "type": "integer"
    },
    "currentProfileVersion": {
      "title": "Currentprofileversion",
      "type": "integer"
    },
    "previousIntentVersion": {
      "title": "Previousintentversion",
      "type": "integer"
    },
    "currentIntentVersion": {
      "title": "Currentintentversion",
      "type": "integer"
    },
    "requestedJobIds": {
      "items": {
        "type": "string"
      },
      "title": "Requestedjobids",
      "type": "array"
    },
    "rankingComparable": {
      "title": "Rankingcomparable",
      "type": "boolean"
    },
    "partial": {
      "title": "Partial",
      "type": "boolean"
    },
    "reasonCodes": {
      "items": {
        "type": "string"
      },
      "title": "Reasoncodes",
      "type": "array"
    },
    "addedTargetIds": {
      "items": {
        "type": "string"
      },
      "title": "Addedtargetids",
      "type": "array"
    },
    "removedTargetIds": {
      "items": {
        "type": "string"
      },
      "title": "Removedtargetids",
      "type": "array"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/AnalysisJobComparisonResponse"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "comparisonVersion",
    "sourceThreadId",
    "sourceResultId",
    "threadId",
    "resultId",
    "scope",
    "previousProfileVersion",
    "currentProfileVersion",
    "previousIntentVersion",
    "currentIntentVersion",
    "requestedJobIds",
    "rankingComparable",
    "partial",
    "reasonCodes",
    "addedTargetIds",
    "removedTargetIds",
    "items"
  ],
  "title": "AnalysisComparisonResponse",
  "type": "object"
}
