{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/job-requirement-extraction.schema.json",
  "title": "JobRequirementExtraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "extractionId",
    "jobId",
    "inputHash",
    "extractorVersion",
    "provider",
    "model",
    "promptVersion",
    "traceRunId",
    "requirementCount",
    "createdAt",
    "requirements"
  ],
  "properties": {
    "extractionId": {"type": "string", "minLength": 1},
    "jobId": {"type": "string", "minLength": 1},
    "inputHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "extractorVersion": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "promptVersion": {"type": "string", "minLength": 1},
    "traceRunId": {"type": "string", "minLength": 1},
    "requirementCount": {"type": "integer", "minimum": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "job-requirement.schema.json"}
    }
  }
}
