{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/job.schema.json",
  "title": "Job",
  "type": "object",
  "required": ["id", "title", "company", "remoteStatus", "remoteConfidence", "source", "sourceUrl"],
  "properties": {
    "id": {
      "type": "string",
      "description": "JobLens 生成的内部 Job Resource ID；不是 Collector 或招聘网站的外部岗位 ID。"
    },
    "title": {"type": "string"},
    "company": {"type": "string"},
    "area": {"type": ["string", "null"]},
    "salaryMinK": {"type": ["number", "null"]},
    "salaryMaxK": {"type": ["number", "null"]},
    "experience": {"type": ["string", "null"]},
    "education": {"type": ["string", "null"]},
    "description": {"type": ["string", "null"]},
    "skills": {"type": "array", "items": {"type": "string"}},
    "remoteStatus": {
      "type": "string",
      "enum": ["confirmed", "rejected", "unknown"],
      "description": "岗位远程事实：明确支持、明确不支持或信息不足。"
    },
    "remoteConfidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "远程状态判断的规则置信等级，不表示概率。"
    },
    "source": {"type": "string"},
    "sourceUrl": {"type": "string"},
    "sourceVersion": {"type": ["string", "null"]},
    "descriptionQuality": {
      "type": ["string", "null"],
      "enum": ["full_jd", "partial_jd", "card_only", "unavailable", null],
      "description": "Collector 对岗位描述完整性的可复现质量分级。"
    },
    "requirementReviewEligible": {
      "type": ["boolean", "null"],
      "description": "是否允许进入 JobRequirement 抽取与人工质量验收。"
    },
    "requirementReviewIneligibilityReasons": {
      "type": "array",
      "items": {"type": "string"}
    },
    "collectedAt": {"type": ["string", "null"]},
    "lastSeenAt": {"type": ["string", "null"], "format": "date-time", "description": "选中来源当前保存的 lastSeenAt；来源未提供时可能使用报告或系统记录时间，不表示岗位仍开放或为所有历史观察的最大时间。"},
    "userMarkedInactive": {"type": "boolean", "description": "用户主动标记不再考虑；不代表招聘网站的客观状态。"},
    "availabilityRevision": {"type": "integer", "minimum": 0}
  }
}
