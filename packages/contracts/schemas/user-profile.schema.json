{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://joblens.local/schemas/user-profile.schema.json",
  "title": "UserProfile",
  "type": "object",
  "required": [
    "id",
    "version",
    "headline",
    "yearsOfExperience",
    "skills",
    "evidence",
    "createdAt"
  ],
  "properties": {
    "id": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "headline": {"type": "string", "minLength": 1},
    "yearsOfExperience": {"type": ["number", "null"], "minimum": 0},
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "level", "evidenceIds"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string", "minLength": 1},
          "level": {"enum": ["strong", "working", "basic", "unknown"]},
          "evidenceIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          }
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "key", "type", "summary", "source"],
        "properties": {
          "id": {"type": "string"},
          "key": {"type": "string", "minLength": 1},
          "type": {
            "enum": ["work", "project", "education", "achievement", "self_report"]
          },
          "summary": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "createdAt": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
