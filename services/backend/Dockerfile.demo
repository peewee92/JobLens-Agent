FROM python:3.12-slim
WORKDIR /app
RUN pip install --no-cache-dir uv==0.9.7
COPY services/backend/pyproject.toml services/backend/uv.lock ./
RUN uv sync --frozen --no-dev
COPY services/backend/app ./app
COPY services/backend/alembic ./alembic
COPY services/backend/alembic.ini ./
COPY services/backend/scripts/seed_product_demo.py ./scripts/seed_product_demo.py
ENV PATH="/app/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 10001 joblens
USER joblens
# One process only: session registry and ephemeral files are intentionally local.
CMD ["sh", "-c", "exec uvicorn app.demo.public_main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-access-log"]
