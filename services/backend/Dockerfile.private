FROM python:3.12-slim
WORKDIR /app/services/backend
RUN pip install --no-cache-dir uv==0.9.7
COPY services/backend/pyproject.toml services/backend/uv.lock ./
RUN uv sync --frozen --no-dev --extra cloud
COPY services/backend/app ./app
COPY services/backend/alembic ./alembic
COPY services/backend/alembic.ini ./
ENV PATH="/app/services/backend/.venv/bin:$PATH" PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN useradd --create-home --uid 10001 joblens
USER joblens
# No demo seed, credentials in the image or automatic migration of visitors' data.
CMD ["sh", "-c", "exec uvicorn app.cloud.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --no-access-log"]
