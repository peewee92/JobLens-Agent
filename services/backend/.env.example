APP_ENV=local
DATABASE_URL=sqlite:///./data/joblens.db

# Profile Extraction: disabled | fixture | openai
PROFILE_EXTRACTOR_PROVIDER=disabled
PROFILE_EXTRACTOR_MODEL=
PROFILE_EXTRACTOR_TIMEOUT_SECONDS=60

# Job Requirement Extraction: disabled | fixture | openai
REQUIREMENT_EXTRACTOR_PROVIDER=disabled
REQUIREMENT_EXTRACTOR_MODEL=
# responses | chat_completions
REQUIREMENT_EXTRACTOR_API_STYLE=responses
# Optional OpenAI-compatible gateway controls; leave blank unless the gateway supports them.
REQUIREMENT_EXTRACTOR_ENABLE_THINKING=
REQUIREMENT_EXTRACTOR_MAX_COMPLETION_TOKENS=
REQUIREMENT_EXTRACTOR_TIMEOUT_SECONDS=60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
