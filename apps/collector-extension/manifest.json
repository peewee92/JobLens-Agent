{
  "manifest_version": 3,
  "name": "岗位筛选",
  "version": "1.3.1",
  "description": "通用 BOSS 岗位搜索、采集与筛选工具；默认内置 AI/大模型岗位关键词模板，支持多城市、全国远程、薪资过滤和 CSV/JSON 导出。",
  "permissions": ["tabs", "storage", "downloads"],
  "host_permissions": ["https://www.zhipin.com/*"],
  "action": {
    "default_title": "岗位筛选 v1.3.1",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.zhipin.com/*"],
      "js": ["lib.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
