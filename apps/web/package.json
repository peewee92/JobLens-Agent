{
  "name": "@joblens/web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "env -u NODE_OPTIONS next dev --port 3000",
    "build": "env -u NODE_OPTIONS next build",
    "start": "env -u NODE_OPTIONS next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "smoke:eval-review": "node scripts/profile-eval-review-smoke.mjs",
    "smoke:requirement-review": "node scripts/requirement-eval-review-smoke.mjs",
    "smoke:career-context-release": "node scripts/career-context-release-smoke.mjs",
    "smoke:manual-requirement-review": "node scripts/requirement-manual-review-smoke.mjs",
    "smoke:requirement-readiness": "node scripts/requirement-readiness-smoke.mjs"
  },
  "dependencies": {
    "@neon/auth": "0.8.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "postcss": "^8.4.31",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.4",
    "typescript": "6.0.3"
  }
}
